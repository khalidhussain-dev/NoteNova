# --- OS & editor junk ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*~

# --- Gradle ---
.gradle/
build/
**/build/
!src/**/build/
gradle-app.setting
!gradle-wrapper.jar

# --- Android Studio / IntelliJ IDEA ---
.idea/
*.iml
*.ipr
*.iws
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/gradle.xml
.idea/misc.xml
.idea/deploymentTargetSelector.xml
.idea/runConfigurations.xml
.idea/shelf/
.idea/*.xml
!.idea/codeStyles/
!.idea/inspectionProfiles/

# --- Local SDK & secrets (never commit) ---
local.properties
*.keystore
!debug.keystore
google-services.json
secrets.properties

# --- Native / NDK ---
.externalNativeBuild/
.cxx/
*.o
*.so
!**/src/main/**/jniLibs/**/*.so

# --- Build outputs & packaging ---
/captures/
*.apk
*.aab
*.ap_
*.dex
output.json
app/build/
app/release/

# --- Kotlin / KSP ---
.kotlin/
**/kspCaches/
**/generated/
!**/src/**/generated/

# --- Logs & diagnostics ---
*.log
hs_err_pid*

# --- Test / coverage ---
.test_cache/
coverage/
*.exec

# --- Misc ---
*.hprof
